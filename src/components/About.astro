---
import AboutEffect from './about-effects/AboutEffect';
import type { AboutEffectVariant } from '../lib/about-effects';
import type { DitherArtVariant } from '../lib/dither-art';

interface Props { effect?: AboutEffectVariant; ditherImage?: DitherArtVariant; preview?: boolean; }
const { effect, ditherImage, preview = false } = Astro.props;
---

<section class:list={['about', { 'about--effect': effect }]} id="about">
  <div class="container">
    <div class="section-label reveal"><span class="idx">01 /</span> About</div>
    <div class="about-grid">
      <div class="about-text">
        <h2 class="section-title reveal reveal-delay-1">About me</h2>
        <p class="reveal reveal-delay-2">
          I’m studying computer science and operations research at Cornell. My interests center on AI research and engineering, especially how agents use tools, work together, and run efficiently.
        </p>
        <p class="reveal reveal-delay-3">
          I enjoy bridging the gap between literature and implementation. I’ve worked on inference scheduling, agent evaluation, and production AI systems.
        </p>
        <p class="reveal reveal-delay-4">
          Outside of that, I’m usually running, at the gym, or watching a YouTube video essay.
        </p>
      </div>
      <div class:list={['about-side', { 'about-side--laser-flow': effect === 'laser-flow' }]}>
      <div class="spec-sheet reveal reveal-delay-3">
        <div class="spec-row">
          <span class="spec-key">Location</span>
          <span class="spec-value">Wayne, PA</span>
        </div>
        <div class="spec-row">
          <span class="spec-key">Education</span>
          <span class="spec-value">B.S. Computer Science + Operations Research &amp; Engineering — Cornell, Class of 2028</span>
        </div>
        <div class="spec-row">
          <span class="spec-key">Focus</span>
          <span class="spec-value">AI evaluation · Agentic systems · Reinforcement learning</span>
        </div>
        <div class="spec-row">
          <span class="spec-key">Toolkit</span>
          <span class="spec-value">Python · PyTorch · TypeScript · FastAPI · Cloudflare</span>
        </div>
      </div>
      {effect && <AboutEffect variant={effect} imageOption={ditherImage} showControls={preview} client:only="react" />}
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    border-top: 0;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  .about-side {
    position: relative;
    min-width: 0;
  }

  .about-text p {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.75;
    margin-bottom: 1rem;
  }

  @media (max-width: 768px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
