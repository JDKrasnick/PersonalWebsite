---
// Astro-native interpretation of Kedhareswer Naidu's Contribution Skyline:
// https://21st.dev/@kedhareswer/components/contribution-skyline
---

<div class="skyline" id="contribution-skyline" data-skyline>
  <div class="skyline-header">
    <div>
      <h3>Contribution skyline</h3>
      <a href="https://github.com/JDKrasnick" target="_blank" rel="noopener noreferrer">@JDKrasnick <span aria-hidden="true">↗</span></a>
    </div>
    <div class="skyline-controls">
      <div class="view-controls" role="group" aria-label="Contribution view">
        <button type="button" data-view="2d" aria-pressed="true"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 2h4v4H2zM10 2h4v4h-4zM2 10h4v4H2zM10 10h4v4h-4z" /></svg>Grid</button>
        <button type="button" data-view="3d" aria-pressed="false"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 14V8h3v6M7 14V2h3v12M12 14V5h3v9" /></svg>Skyline</button>
        <div class="cycle-countdown" data-cycle-countdown aria-hidden="true" hidden><span data-cycle-progress></span></div>
      </div>
      <div class="palette-controls" role="group" aria-label="Color palette">
        {[
          ['blue', 'Periwinkle', '#8ca1ee'], ['green', 'GitHub green', '#39d353'],
          ['amber', 'Amber', '#ffcf83'], ['rose', 'Rose', '#db8bb0'],
          ['teal', 'Teal', '#66bdc8'], ['violet', 'Violet', '#ab91da'],
          ['black', 'Black', '#17191d'],
        ].map(([value, label, color]) => <button type="button" class="palette-swatch" data-palette={value} aria-label={label} title={label} aria-pressed={value === 'blue' ? 'true' : 'false'} style={`--swatch: ${color}`}><span /></button>)}
      </div>
      <button type="button" class="reset-control" data-reset aria-label="Reset skyline rotation" title="Reset view" disabled><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 7a6.5 6.5 0 1 1-.3 5M4 3v4h4" /></svg></button>
    </div>
  </div>
  <div class="skyline-workspace">
    <div class="skyline-stage" aria-busy="true">
      <canvas tabindex="0" role="img" aria-label="GitHub contribution graph. Arrow keys explore days; Enter opens a day summary. Drag the skyline to orbit." aria-describedby="skyline-help skyline-detail"></canvas>
      <div class="skyline-status" role="status">
        <span class="sr-only">Loading GitHub activity…</span>
        <div class="calendar-ghost loading-ghost" aria-hidden="true">{Array.from({ length: 371 }, () => <span />)}</div>
      </div>
      <div class="skyline-tooltip" aria-hidden="true" hidden></div>
    </div>
  </div>
    <div class="day-summary" popover="auto" role="dialog" aria-labelledby="day-summary-title" hidden>
      <div class="day-summary-header"><h4 id="day-summary-title">GitHub activity</h4><button type="button" class="close-summary" data-close-summary aria-label="Close day summary"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 5 10 10M15 5 5 15" /></svg></button></div>
      <p class="day-date" data-day-date></p>
      <p class="day-count"><span data-day-count>0</span> <span data-day-unit>contributions</span></p>
      <div class="day-history" data-day-history aria-live="polite" aria-busy="false"></div>
      <p class="day-coverage">Public activity; PR metrics reflect current totals. Calendar counts can include contributions without a public activity record.</p>
      <a class="day-link" data-day-link href="https://github.com/JDKrasnick" target="_blank" rel="noopener noreferrer">View this day on GitHub<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 12 12 4M4 4h8v8" /></svg></a>
    </div>
  <div class="skyline-footer">
    <p id="skyline-help">Click a day to explore · Arrow keys + Enter</p>
    <div class="skyline-legend" aria-label="Contribution intensity from less to more">
      <span>Less</span>{[0, 1, 2, 3, 4].map(level => <i data-level={level} />)}<span>More</span>
    </div>
  </div>
  <p id="skyline-detail" class="skyline-detail sr-only" aria-live="polite"></p>
  <dl class="skyline-stats" hidden>
    <div><dt>Contributions</dt><dd data-stat="total">—</dd></div>
    <div><dt>Busiest day</dt><dd data-stat="busiest">—</dd></div>
    <div><dt>Longest streak</dt><dd data-stat="streak">—</dd></div>
  </dl>
  <noscript><p>Enable JavaScript to explore the skyline, or <a href="https://github.com/JDKrasnick">view activity on GitHub</a>.</p></noscript>
</div>

<script>
  import '../scripts/contribution-skyline';
</script>

<style>
  .skyline { --skyline-0: #202740; --skyline-1: #3d4f8c; --skyline-2: #627ac6; --skyline-3: #8ca1ee; --skyline-4: #c0cdff; margin-top: 4rem; border-top: 1px solid var(--border-color); padding-top: 2rem; }
  .skyline-header, .skyline-controls, .skyline-footer, .skyline-legend { display: flex; align-items: center; }
  .skyline-header, .skyline-footer { justify-content: space-between; gap: 1rem; }
  h3 { font-size: 1.25rem; margin-bottom: 0.4rem; }
  .skyline-header a { font-size: 0.875rem; }
  .skyline-controls { gap: 1rem; flex-wrap: wrap; }
  button, .skyline-status :global(button) { min-height: 44px; border: 0; background: transparent; color: var(--text-secondary); font: inherit; font-size: 0.8125rem; cursor: pointer; transition: color 160ms, background 160ms, box-shadow 160ms; }
  svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; flex-shrink: 0; }
  .view-controls { position: relative; display: flex; padding: 4px; gap: 4px; background: #11162a; border-radius: 12px; }
  .cycle-countdown { position: absolute; bottom: -5px; left: 8px; right: 8px; height: 1px; overflow: hidden; border-radius: 1px; background: rgb(167 151 202 / 5%); pointer-events: none; }
  .cycle-countdown span { display: block; width: 100%; height: 100%; background: rgb(167 151 202 / 42%); transform-origin: center; }
  .view-controls button { display: inline-flex; align-items: center; gap: 8px; padding: 0.6rem 1rem; border-radius: 8px; font-weight: 500; }
  .view-controls button[aria-pressed="true"] { background: #283354; color: #e3e9ff; box-shadow: 0 2px 5px rgb(0 0 0 / 20%); }
  button:hover { color: var(--text-primary); background: rgb(140 161 238 / 8%); }
  button:disabled { opacity: 0.35; cursor: default; }
  .palette-controls { display: flex; align-items: center; gap: 0; }
  .palette-swatch { display: grid; place-items: center; width: 30px; padding: 0; border-radius: 8px; }
  .palette-swatch span { width: 12px; height: 12px; border-radius: 50%; background: var(--swatch); outline: 1px solid transparent; outline-offset: 4px; transition: outline-color 160ms, transform 160ms; }
  .palette-swatch[aria-pressed="true"] span { outline-color: var(--swatch); }
  .palette-swatch:hover span { transform: scale(1.15); }
  .palette-swatch[data-palette="black"] span { box-shadow: 0 0 0 1px #7e8490; }
  .palette-swatch[data-palette="black"][aria-pressed="true"] span { outline-color: #a7afb9; }
  .reset-control, .close-summary { display: grid; place-items: center; width: 44px; padding: 0; border-radius: 8px; }
  .reset-control { border: 1px solid var(--border-color); }
  button:focus-visible, .day-link:focus-visible, .skyline-status :global(button:focus-visible) { outline: 2px solid var(--accent); outline-offset: 4px; }
  canvas:focus { outline: none; }
  .skyline:has(canvas:focus-visible) #skyline-help { color: var(--text-primary); text-decoration: underline; text-underline-offset: 4px; }
  .skyline-workspace { display: grid; grid-template-columns: minmax(0, 1fr); align-items: center; gap: 24px; margin-top: 1.5rem; }
  .skyline-stage { min-width: 0; position: relative; height: 330px; }
  canvas { width: 100%; height: 100%; display: block; cursor: crosshair; touch-action: pan-y; user-select: none; -webkit-user-select: none; }
  .skyline[data-view="3d"] canvas { cursor: grab; touch-action: none; }
  .skyline[data-dragging="true"] canvas { cursor: grabbing; }
  .skyline-status { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 1rem; color: var(--text-secondary); text-align: center; }
  .skyline-status[hidden], .skyline-tooltip[hidden], .skyline-stats[hidden] { display: none; }
  .skyline :global(.loading-label) { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .skyline :global(.loading-ghost) { position: relative; overflow: hidden; isolation: isolate; }
  .skyline :global(.loading-ghost::after) { content: ''; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(100deg, transparent 20%, rgb(164 181 244 / 9%) 50%, transparent 80%); transform: translateX(-100%); animation: ghost-sweep 1.8s ease-in-out infinite; }
  .skyline :global(.calendar-ghost) { display: grid; grid-template-columns: repeat(53, minmax(0, 1fr)); grid-template-rows: repeat(7, minmax(0, 1fr)); grid-auto-flow: column; gap: 3px; width: calc(100% - 16px); max-width: 901px; aspect-ratio: 53 / 7; }
  .skyline :global(.calendar-ghost span) { background: #1b2239; border-radius: 2px; }
  .skyline :global(.history-ghost) { width: 100%; }
  .skyline :global(.ghost-pr) { padding: 16px 0; border-top: 1px solid var(--border-color); display: flex; flex-direction: column; gap: 10px; }
  .skyline :global(.ghost-line) { display: block; height: 11px; background: #1b2239; border-radius: 4px; width: 100%; }
  .skyline :global(.ghost-line-short) { width: 42%; height: 9px; }
  .skyline :global(.ghost-line-medium) { width: 76%; }
  .skyline :global(.ghost-line-metrics) { width: 62%; height: 9px; margin-top: 4px; }
  @keyframes ghost-sweep { to { transform: translateX(100%); } }
  .day-summary[hidden], .day-summary:not(:popover-open) { display: none; }
  .day-summary {
    position: fixed; inset: auto; margin: 0; width: min(380px, calc(100vw - 24px));
    height: fit-content; max-height: min(480px, calc(100dvh - 24px)); display: flex; flex-direction: column;
    padding: 18px; border: 1px solid var(--border-hover); border-radius: 12px;
    background: var(--bg-secondary); color: var(--text-primary); overflow: auto; overscroll-behavior: contain;
    box-shadow: 0 24px 80px rgb(0 0 0 / 45%); animation: summary-in 180ms ease-out;
  }
  .day-summary-header { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin: -10px -8px 12px 0; }
  h4 { font-size: 0.8125rem; color: var(--text-secondary); font-weight: 500; }
  .day-date { font-size: 1.125rem; color: var(--text-primary); line-height: 1.6; }
  .day-count { margin: 8px 0 18px; display: flex; align-items: baseline; gap: 6px; color: var(--text-secondary); font-size: 0.75rem; }
  [data-day-count] { color: var(--text-primary); font: 500 1rem var(--font-mono); font-variant-numeric: tabular-nums; }
  .day-history { min-height: 0; max-height: min(42dvh, 300px); overflow-y: auto; overscroll-behavior: contain; padding-right: 8px; scrollbar-width: thin; scrollbar-color: #65729c transparent; }
  .day-coverage { margin: 18px 0 12px; color: var(--text-secondary); font-size: 0.6875rem; line-height: 1.6; }
  .day-link { display: inline-flex; align-items: center; gap: 8px; font-size: 0.75rem; text-decoration: underline; text-underline-offset: 4px; }
  .day-history :global(.activity-group-title) { margin: 18px 0 10px; color: var(--text-primary); font-size: 0.75rem; font-weight: 500; }
  .day-history :global(.activity-group-title:first-child) { margin-top: 0; }
  .day-history :global(.activity-pr), .day-history :global(.activity-entry) { padding: 12px 0; border-top: 1px solid var(--border-color); }
  .day-history :global(.activity-entry) { display: flex; flex-direction: column; gap: 5px; }
  .day-history :global(.activity-title), .featured-list :global(.activity-title) { display: block; color: var(--text-primary); font-size: 0.875rem; line-height: 1.5; overflow-wrap: anywhere; }
  .day-history :global(.activity-title:hover), .featured-list :global(.activity-title:hover) { color: var(--accent-hover); }
  .day-history :global(.activity-repo), .featured-list :global(.activity-repo) { display: block; color: var(--text-secondary); font-size: 0.6875rem; line-height: 1.6; overflow-wrap: anywhere; margin-bottom: 6px; }
  .day-history :global(.activity-state), .featured-list :global(.activity-state) { display: inline-block; color: #c8b1f2; font-size: 0.6875rem; line-height: 1.6; margin-top: 7px; }
  .day-history :global(.activity-state[data-state="OPEN"]), .featured-list :global(.activity-state[data-state="OPEN"]) { color: #88d5b1; }
  .day-history :global(.activity-metrics), .featured-list :global(.activity-metrics) { display: flex; gap: 5px 10px; flex-wrap: wrap; margin-top: 9px; font-size: 0.6875rem; color: var(--text-secondary); line-height: 1.6; font-variant-numeric: tabular-nums; }
  .day-history :global(.activity-reason), .featured-list :global(.activity-reason) { margin-top: 8px; color: var(--accent-hover); font-size: 0.6875rem; line-height: 1.6; }
  .day-history :global(.activity-additions), .featured-list :global(.activity-additions) { color: #88d5b1; font-family: var(--font-mono); }
  .day-history :global(.activity-deletions), .featured-list :global(.activity-deletions) { color: #e5a4b7; font-family: var(--font-mono); }
  .day-history :global(.activity-message) { color: var(--text-secondary); font-size: 0.8125rem; line-height: 1.7; }
  .day-history :global(button), .featured-list :global(button) { min-height: 40px; padding: 8px 0; color: var(--accent-hover); font: inherit; font-size: 0.75rem; border: 0; background: transparent; cursor: pointer; text-align: left; }
  .day-history :global(a:focus-visible), .featured-list :global(a:focus-visible), .day-history :global(button:focus-visible), .featured-list :global(button:focus-visible) { outline: 2px solid var(--accent); outline-offset: 3px; }
  @keyframes summary-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
  .skyline-tooltip { position: absolute; pointer-events: none; padding: 0.6rem 0.8rem; border: 1px solid var(--border-color); border-radius: 8px; background: var(--bg-secondary); color: var(--text-primary); font-size: 0.8rem; white-space: nowrap; transform: translate(-50%, -100%); }
  .skyline-footer, .skyline-detail { font-size: 0.75rem; color: var(--text-secondary); }
  .skyline-legend { gap: 4px; }
  .skyline-legend span:first-child { margin-right: 4px; }
  .skyline-legend span:last-child { margin-left: 4px; }
  i { display: block; width: 10px; height: 10px; background: var(--skyline-0); }
  i[data-level="1"] { background: var(--skyline-1); } i[data-level="2"] { background: var(--skyline-2); }
  i[data-level="3"] { background: var(--skyline-3); } i[data-level="4"] { background: var(--skyline-4); }
  .skyline-stats { display: flex; gap: 3rem; padding-top: 1.5rem; margin-top: 1rem; border-top: 1px solid var(--border-color); }
  dt { color: var(--text-secondary); font-size: 0.75rem; margin-bottom: 0.5rem; }
  dd { margin: 0; color: var(--text-primary); font-family: var(--font-mono); font-size: 1.4rem; font-variant-numeric: tabular-nums; }
  dd[data-stat="busiest"] { font-size: 1.05rem; line-height: 1.8; white-space: nowrap; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  @media (max-width: 640px) {
    .skyline-header { align-items: flex-start; flex-direction: column; }
    .skyline-controls { width: 100%; gap: 0.5rem; }
    .view-controls button { padding-inline: 0.75rem; }
    .palette-swatch { width: 26px; }
    .reset-control { margin-left: auto; }
    .day-summary { padding: 16px; }
    .day-count { flex-direction: row; align-items: baseline; gap: 8px; }
    .skyline-stage { height: 260px; }
    .skyline-footer { align-items: flex-start; flex-direction: column; gap: 0.75rem; }
    .skyline-stats { justify-content: space-between; gap: 1rem; }
    dd { font-size: 1.2rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    button, .palette-swatch span { transition: none; }
    .day-summary { animation: none; }
    .skyline :global(.loading-ghost::after) { animation: none; background: none; }
  }
</style>
