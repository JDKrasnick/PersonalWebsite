---
const experiences = [
  {
    role: "AI Engineer Intern",
    company: "Order.co",
    companyUrl: "https://www.order.co",
    period: "May — Aug 2026",
    highlights: [
      "Raised product-offer ingestion success above <b>98%</b> across <b>5,000+ product pages per day</b>, recovering <b>82.7%</b> of blocked URLs through bot-block detection, fallback routing, and jittered backoff",
      "Enabled field-level LLM-as-a-judge evaluation on <b>10%</b> of production parses by transforming OpenTelemetry traces through Airflow into Snowflake models and Metabase dashboards",
      "Built an agentic DOM-interaction flow that set delivery ZIP codes at <b>90%+ completion</b>, unlocking location-aware pricing for approximately <b>80%</b> of vendors",
    ],
    tags: ["Python", "LLM Evaluations", "Airflow", "Snowflake", "Browserbase", "Firecrawl"],
  },
  {
    role: "Research Lead · previously AI Engineer",
    company: "Generative AI at Cornell",
    companyUrl: "https://www.cornellgenai.dev/",
    period: "Feb 2026 — Present",
    highlights: [
      "Built and now lead the organization’s research track, recruiting Cornell faculty advisors and supervising teams running original <b>agent-harness optimization</b> experiments",
      "Expanded ESG monitoring to <b>80 CLO portfolio companies</b> across <b>14+ news providers</b> for Investcorp with BullMQ/Redis ingestion, pgvector deduplication, and GPT-4o materiality classification",
      "Shipped a <b>four-week MVP</b> that turns flagged ESG events into citation-backed credit and covenant summaries for analyst review",
    ],
    tags: ["TypeScript", "AI Agents", "GPT-4o", "BullMQ", "Redis", "PostgreSQL"],
  },
  {
    role: "Undergraduate Researcher",
    company: "Cornell University",
    companyUrl: "https://www.orie.cornell.edu",
    period: "Jan 2026 — Present",
    highlights: [
      "Train deep-reinforcement-learning policies in PyTorch to learn routing and scheduling policies for multiclass queueing networks",
      "Built a FastAPI/WebSocket discrete-event simulator with pluggable scheduling policies and Gym-style environments, validated against <b>M/M/1 and M/M/c</b> closed-form results",
    ],
    tags: ["Deep Reinforcement Learning", "PyTorch", "OpenAI Gym", "FastAPI", "WebSockets", "Queueing Theory"],
  },
];
---

<section class="experience" id="experience">
  <div class="container">
    <div class="section-label reveal"><span class="idx">02 /</span> Experience</div>
    <h2 class="section-title reveal reveal-delay-1">Building systems that hold up in practice.</h2>

    <div class="exp-list">
      {experiences.map((exp, i) => (
        <div class={`exp-item reveal reveal-delay-${(i % 3) + 1}`}>
          <div class="exp-left">
            <span class="exp-period">{exp.period}</span>
          </div>
          <div class="exp-content">
            <div class="exp-header">
              <h3 class="exp-role">{exp.role}</h3>
              <a href={exp.companyUrl} target="_blank" rel="noopener noreferrer" class="exp-company">
                {exp.company}
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
              </a>
            </div>
            <ul class="exp-highlights">
              {exp.highlights.map(h => (
                <li set:html={h} />
              ))}
            </ul>
            <div class="exp-tags">
              {exp.tags.map(tag => (
                <span class="exp-tag">{tag}</span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .experience {
    border-top: 1px solid var(--border-color);
  }

  .exp-list {
    margin-top: 3rem;
    display: flex;
    flex-direction: column;
  }

  .exp-item {
    display: grid;
    grid-template-columns: 150px 1fr;
    gap: 2.5rem;
    padding: 1.875rem 0;
    border-top: 1px solid var(--border-color);
  }

  .exp-item:last-child {
    border-bottom: 1px solid var(--border-color);
  }

  .exp-left {
    padding-top: 0.15rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .exp-period {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-secondary);
    white-space: nowrap;
  }

  .exp-header {
    margin-bottom: 0.75rem;
  }

  .exp-role {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: -0.01em;
  }

  .exp-company {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.875rem;
    color: var(--accent);
    margin-top: 0.15rem;
  }

  .exp-highlights {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-bottom: 1rem;
  }

  .exp-highlights li {
    font-size: 0.85rem;
    color: var(--text-secondary);
    padding-left: 1rem;
    position: relative;
  }

  .exp-highlights li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5rem;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--text-muted);
  }

  .exp-highlights li :global(b) {
    color: var(--text-primary);
    font-weight: 600;
  }

  .exp-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .exp-tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    background: var(--bg-card);
    color: var(--text-secondary);
    border: 1px solid var(--border-color);
  }

  @media (max-width: 768px) {
    .exp-item {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
</style>
