---
import { skillIcons, type SkillIconName } from '../lib/skill-icons';

const skillCategories: { title: string; skills: { name: string; icon: SkillIconName }[] }[] = [
  {
    title: "Languages",
    skills: [
      { name: "Python", icon: "python" },
      { name: "TypeScript", icon: "typescript" },
      { name: "Java", icon: "java" },
      { name: "SQL", icon: "sql" },
      { name: "C++", icon: "cpp" },
    ],
  },
  {
    title: "AI / Machine Learning",
    skills: [
      { name: "PyTorch", icon: "pytorch" },
      { name: "JAX", icon: "jax" },
      { name: "CUDA", icon: "cuda" },
      { name: "scikit-learn", icon: "scikit-learn" },
      { name: "LLM Agents & Evals", icon: "agents-evals" },
      { name: "Reinforcement Learning", icon: "rl" },
    ],
  },
  {
    title: "Backend & Data",
    skills: [
      { name: "FastAPI", icon: "fastapi" },
      { name: "Fastify", icon: "fastify" },
      { name: "MongoDB", icon: "mongodb" },
      { name: "PostgreSQL", icon: "postgresql" },
      { name: "Redis / BullMQ", icon: "redis" },
    ],
  },
  {
    title: "Cloud & Infrastructure",
    skills: [
      { name: "Cloudflare", icon: "cloudflare" },
      { name: "AWS", icon: "aws" },
      { name: "Docker", icon: "docker" },
      { name: "Airflow", icon: "airflow" },
      { name: "Snowflake", icon: "snowflake" },
    ],
  },
];

---

<section class="skills" id="skills">
  <div class="container">
    <div class="section-label reveal"><span class="idx">04 /</span> Skills</div>
    <h2 class="section-title reveal reveal-delay-1">Tech Stack</h2>
    <p class="section-subtitle reveal reveal-delay-2">
      The tools I use to evaluate models, build agentic systems, and ship reliable data products.
    </p>

    <div class="skills-grid">
      {skillCategories.map((cat, i) => (
        <div class={`skill-category reveal reveal-delay-${(i % 4) + 1}`}>
          <h3 class="category-title">{cat.title}</h3>
          <ul class="skill-tags" role="list">
            {cat.skills.map(skill => {
              const icon = skillIcons[skill.icon];
              const src = `/icons/skills/official/native/${icon.file}`;
              return <li class="skill-tag">
                <span class="skill-icon" data-icon={skill.icon} style={`--skill-icon: url('${src}')`} aria-hidden="true"></span>
                <span>{skill.name}</span>
              </li>;
            })}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .skills {
    padding-top: 2.5rem;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2.25rem;
    margin-top: 2.75rem;
  }

  .skill-category {
    padding: 0;
  }

  .category-title {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--accent);
    margin-bottom: 1.1rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .skill-tags {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .skill-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 1.5rem;
    font-size: 0.83rem;
    color: var(--text-secondary);
    transition: color var(--transition-fast);
  }

  .skill-tag:hover {
    color: var(--text-primary);
  }

  .skill-icon {
    display: inline-block;
    width: 20px;
    height: 20px;
    flex: 0 0 20px;
    background: #9b8af7;
    mask: var(--skill-icon) center / contain no-repeat;
    opacity: 0.82;
    transition: opacity var(--transition-fast);
  }

  .skill-tag:hover .skill-icon {
    opacity: 1;
  }

  /* The eye's visual weight sits below the center of its SVG canvas. */
  .skill-icon[data-icon="cuda"] {
    transform: translateY(-1px);
  }

  @media (max-width: 900px) {
    .skills-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
  }

  @media (max-width: 640px) {
    .skills-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
