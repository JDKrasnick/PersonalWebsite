---
import { skillCategories } from '../data/skills';

---

<section class="skills" id="skills">
  <div class="container">
    <div class="section-label reveal"><span class="idx">04 /</span> Skills</div>
    <h2 class="section-title reveal reveal-delay-1">Tech Stack</h2>
    <p class="section-subtitle reveal reveal-delay-2">
      The tools I use to evaluate models, build agentic systems, and ship reliable data products.
    </p>

    <div class="skills-grid">
      {skillCategories.map((cat, i) => (
        <div class={`skill-category reveal reveal-delay-${(i % 4) + 1}`}>
          <h3 class="category-title">{cat.title}</h3>
          <div class="skill-tags">
            {cat.skills.map(skill => (
              <span class="skill-tag">
                <span class="skill-marker" aria-hidden="true"></span>
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2.25rem;
    margin-top: 2.75rem;
  }

  .skill-category {
    padding: 0;
  }

  .category-title {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--accent);
    margin-bottom: 1.1rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .skill-tags {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .skill-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.83rem;
    color: var(--text-secondary);
    transition: color var(--transition-fast);
  }

  .skill-tag:hover {
    color: var(--text-primary);
  }

  .skill-marker {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
    opacity: 0.55;
    transition: opacity var(--transition-fast), transform var(--transition-fast);
  }

  .skill-tag:hover .skill-marker {
    opacity: 1;
    transform: scale(1.35);
  }

  @media (max-width: 900px) {
    .skills-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
  }

  @media (max-width: 640px) {
    .skills-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
