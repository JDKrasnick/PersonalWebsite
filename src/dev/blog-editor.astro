---
import BlogLayout from '../layouts/BlogLayout.astro';
import BlogArrow from '../components/BlogArrow.astro';
---
<BlogLayout title="Editor" editor>
  <div class="editor-bar">
    <div class="post-picker"><label class="sr-only" for="post-selector">Choose a post</label><select id="post-selector" aria-label="Choose a post"><option>Loading posts…</option></select><button id="new-post" class="button button-quiet">New post</button></div>
    <div class="editor-actions"><span id="save-state" role="status">Ready to write</span><button id="save-draft" class="button button-quiet" title="Save draft · Cmd/Ctrl+S" aria-keyshortcuts="Meta+S Control+S">Save draft</button><button id="open-preview" class="button button-quiet" aria-pressed="false" aria-controls="editor-preview" title="Toggle preview · Cmd/Ctrl+Shift+P" aria-keyshortcuts="Meta+Shift+P Control+Shift+P">Preview</button><button id="assistant-toggle" type="button" class="button button-quiet" aria-expanded="false" aria-controls="blog-assistant">Assistant</button><button id="publish-post" class="button button-primary">Prepare for GitHub</button></div>
  </div>
  <div id="editor-error" class="notice error editor-error" role="alert" hidden></div>
  <div id="editor-workspace" class="editor-workspace">
  <div class="editor-document">
  <article class="article-editor" aria-label="Editable blog post">
    <header class="article-header editable-header">
      <div class="editor-article-meta"><span id="post-state" class="status-badge">Draft</span></div>
      <label class="sr-only" for="post-title">Post title</label><textarea id="post-title" class="article-edit-title" rows="1" placeholder="Untitled post" maxlength="180"></textarea>
      <label class="sr-only" for="post-excerpt">Description</label><textarea id="post-excerpt" class="article-edit-description" rows="1" placeholder="Add a short description…" maxlength="400"></textarea>
      <div id="editor-picture" class="article-picture" hidden><div id="editor-picture-preview"></div><p id="editor-picture-error" class="picture-error" hidden>Picture could not load. Check the image URL below.</p></div>
      <details id="picture-settings" class="picture-settings"><summary>Add picture</summary><div class="picture-fields"><button id="choose-cover" type="button" class="picture-dropzone" aria-describedby="picture-help">Drop a picture here or <span>choose a file</span></button><p id="picture-help">PNG, JPG, WebP, GIF, or AVIF · Up to 10 MB. Saved with your site’s files.</p><div><label for="post-image">Or paste a picture URL</label><input id="post-image" maxlength="2000" placeholder="https://… or /blog-images/your-picture.jpg" /></div><div><label for="post-image-alt">Describe the picture</label><input id="post-image-alt" maxlength="240" placeholder="A short description for screen readers" /></div><button id="remove-picture" type="button" class="text-button" hidden>Remove picture</button></div></details>
      <input id="picture-file" type="file" accept="image/png,image/jpeg,image/webp,image/gif,image/avif" hidden />
      <p id="picture-upload-state" class="picture-upload-state" role="status" hidden></p>
      <details class="post-settings"><summary>Post settings</summary><div class="post-fields"><div><label for="post-slug">URL slug</label><input id="post-slug" maxlength="100" placeholder="your-post-title" autocomplete="off" /></div><div><label for="post-tags">Tags</label><input id="post-tags" maxlength="200" placeholder="AI, Engineering" /></div></div></details>
    </header>
    <div class="document-toolbar" role="toolbar" aria-label="Text formatting">
      <div class="format-actions">
        <label class="sr-only" for="text-style">Text style</label><select id="text-style"><option value="paragraph">Paragraph</option><option value="2">Heading 2</option><option value="3">Heading 3</option><option value="4">Heading 4</option></select>
        <button type="button" data-format="bold" title="Bold · Cmd/Ctrl+B" aria-label="Bold" aria-pressed="false"><strong>B</strong></button>
        <button type="button" data-format="italic" title="Italic · Cmd/Ctrl+I" aria-label="Italic" aria-pressed="false"><em>I</em></button>
        <button type="button" data-format="strike" title="Strikethrough" aria-label="Strikethrough" aria-pressed="false"><s>S</s></button>
        <button type="button" data-format="inline-code" title="Inline code" aria-label="Inline code" aria-pressed="false"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="m8 7-5 5 5 5m8-10 5 5-5 5"/></svg></button>
        <button type="button" data-format="link" title="Link" aria-label="Insert link"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="m10 13 4-4m-6 7-2 2a4 4 0 0 1-6-6l5-5a4 4 0 0 1 6 0m2 1 2-2a4 4 0 0 1 6 6l-5 5a4 4 0 0 1-6 0" transform="translate(1 0)"/></svg></button>
        <button type="button" data-format="quote" title="Block quote" aria-label="Block quote" aria-pressed="false"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M10 5H3v8h5c0 3-2 5-4 6M21 5h-7v8h5c0 3-2 5-4 6"/></svg></button>
        <button type="button" data-format="list" title="Bullet list" aria-label="Bullet list" aria-pressed="false"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13M3 6h1M3 12h1M3 18h1"/></svg></button>
        <button type="button" data-format="ordered-list" title="Numbered list" aria-label="Numbered list" aria-pressed="false"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M9 6h12M9 12h12M9 18h12M3 3h1v6M2 13c4-3 5 1 2 3l-2 3h4"/></svg></button>
        <button type="button" data-format="code" title="Code block" aria-label="Code block" aria-pressed="false"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="m8 7-5 5 5 5m8-10 5 5-5 5M14 4l-4 16"/></svg></button>
        <button type="button" data-format="divider" title="Divider" aria-label="Insert divider"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M3 12h18"/></svg></button>
        <button type="button" data-format="undo" title="Undo · Cmd/Ctrl+Z" aria-label="Undo"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M4 10h10a6 6 0 0 1 0 12M4 10l5-5M4 10l5 5"/></svg></button>
        <button type="button" data-format="redo" title="Redo · Cmd/Ctrl+Shift+Z" aria-label="Redo"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M20 10H10a6 6 0 0 0 0 12M20 10l-5-5M20 10l-5 5"/></svg></button>
      </div>
      <div class="document-modes" role="group" aria-label="Editing mode"><button type="button" data-editor-mode="document" aria-pressed="true">Write</button><button type="button" data-editor-mode="markdown" aria-pressed="false">Markdown</button></div>
      <div class="insert-actions"><button id="insert-picture" type="button" class="text-button">Insert picture</button><button type="button" data-format="table" class="text-button">Insert table</button><button id="insert-demo" type="button" class="text-button" title="Insert an interactive demo block">Insert demo</button><button type="button" data-format="clear" class="text-button" title="Clear formatting · Cmd/Ctrl+Backslash">Clear formatting</button><button type="button" data-format="indent" class="text-button" title="Indent list item · Tab">Indent</button><button type="button" data-format="outdent" class="text-button" title="Outdent list item · Shift+Tab">Outdent</button><button id="find-toggle" type="button" class="text-button" aria-expanded="false" aria-controls="editor-find" title="Find / replace · Cmd/Ctrl+Shift+F">Find / replace</button><span id="table-actions" hidden><button type="button" data-format="row" class="text-button">Add row</button><button type="button" data-format="column" class="text-button">Add column</button><button type="button" data-format="remove-row" class="text-button">Delete row</button><button type="button" data-format="remove-column" class="text-button">Delete column</button><button type="button" data-format="remove-table" class="text-button">Remove table</button></span></div>
      <details id="editor-shortcuts" class="editor-shortcuts"><summary>Keyboard shortcuts</summary><dl><div><dt>Save</dt><dd><kbd>Cmd/Ctrl S</kbd></dd></div><div><dt>Preview on / off</dt><dd><kbd>Cmd/Ctrl Shift P</kbd></dd></div><div><dt>Exit preview</dt><dd><kbd>Esc</kbd></dd></div><div><dt>Write / Markdown</dt><dd><kbd>Cmd/Ctrl Shift M</kbd></dd></div><div><dt>Find / replace</dt><dd><kbd>Cmd/Ctrl Shift F</kbd></dd></div><div><dt>Bold / italic / link</dt><dd><kbd>Cmd/Ctrl B / I / K</kbd></dd></div><div><dt>Strikethrough</dt><dd><kbd>Cmd/Ctrl Shift S</kbd></dd></div><div><dt>Clear formatting (Write)</dt><dd><kbd>Cmd/Ctrl Backslash</kbd></dd></div><div><dt>Heading 2–4 / paragraph</dt><dd><kbd>Cmd/Ctrl Alt 2–4 / 0</kbd></dd></div><div><dt>Undo / redo</dt><dd><kbd>Cmd/Ctrl Z / Shift Z</kbd></dd></div><div><dt>Indent / outdent list (Write)</dt><dd><kbd>Tab / Shift Tab</kbd></dd></div><div><dt>New line without paragraph</dt><dd><kbd>Shift Enter</kbd></dd></div></dl><p>In Write, start a line with <code>##</code>, <code>-</code>, <code>1.</code>, or <code>&gt;</code> followed by a space. Use three backticks for a code block.</p></details>
    </div>
    <section id="editor-find" class="editor-find" aria-label="Find and replace in article" hidden><div class="find-fields"><label>Find<input id="find-query" type="text" autocomplete="off" /></label><label>Replace with<input id="find-replacement" type="text" autocomplete="off" /></label></div><div class="find-actions"><label class="find-case"><input id="find-case" type="checkbox" /> Match case</label><span id="find-count" role="status">Search article text</span><button id="find-previous" type="button" class="text-button">Previous</button><button id="find-next" type="button" class="text-button">Next</button><button id="replace-match" type="button" class="text-button">Replace</button><button id="replace-all" type="button" class="text-button">Replace all</button><button id="find-close" type="button" class="text-button">Close</button></div></section>
    <div id="rich-editor" class="document-editor"></div>
    <div id="markdown-source" hidden><label class="sr-only" for="post-content">Markdown source</label><textarea id="post-content" class="markdown-source" rows="10" placeholder="Write your article…" spellcheck="false"></textarea></div>
    <p id="demo-editor-hint" class="demo-editor-hint" hidden>Demo blocks reference HTML files in public/blog-demos. Edit the JSON here; Preview runs the demo.</p>
    <div class="writing-footer"><span id="word-count">0 words</span><span>Drop or paste pictures into your article. Drafts save automatically.</span></div>
    <div class="post-management"><span id="published-note">Only you can see this draft.</span><div><button id="unpublish-post" class="text-button" hidden>Remove GitHub file</button><button id="delete-post" class="text-button danger">Delete post</button></div></div>
  </article>
  <section id="editor-preview" class="editor-preview reader-wrap" aria-label="Draft preview" hidden>
    <div class="editor-preview-heading"><p>Preview · Esc to return to editing</p><button id="close-editor-preview" type="button" class="button button-quiet">Edit post</button></div>
    <article id="editor-preview-article"></article>
  </section>
  </div>
  <aside id="blog-assistant" class="editor-assistant" aria-label="ChatGPT writing assistant" hidden>
    <div class="assistant-heading"><h2>ChatGPT</h2><button id="assistant-new-chat" type="button" class="text-button">New chat</button><button id="assistant-close" type="button" class="assistant-icon-button" aria-label="Close assistant"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m6 6 12 12M6 18 18 6"/></svg></button></div>
    <div class="assistant-connection"><p id="assistant-connection" role="status">Checking connection…</p><button id="assistant-reconnect" type="button" class="text-button">Reconnect</button></div>
    <p class="assistant-help">Work on your writing or create an image script. Images default to code you can edit and run.</p>
    <div id="assistant-messages" class="assistant-messages" role="log" aria-label="Conversation" aria-live="polite"><p class="assistant-empty">What would you like to work on?</p></div>
    <p id="assistant-progress" class="assistant-progress" role="status" hidden>Thinking…</p>
    <p id="assistant-error" class="assistant-error" role="alert" hidden></p>
    <form id="assistant-form" class="assistant-form">
      <label class="sr-only" for="assistant-prompt">Message ChatGPT</label><textarea id="assistant-prompt" rows="4" maxlength="12000" placeholder="Ask about your post or describe an image…"></textarea>
      <label class="assistant-context"><input id="assistant-attach-post" type="checkbox" /> Attach post text</label>
      <div class="assistant-send-actions"><button id="assistant-send" type="submit" class="button button-primary">Send</button><button id="assistant-stop" type="button" class="button button-quiet" hidden>Stop</button><button id="assistant-use-selection" type="button" class="text-button">Use selection</button></div>
    </form>
    <div class="assistant-image-actions"><button id="assistant-image-script" type="button" class="button button-quiet">Create image script</button><button id="assistant-image-chat" type="button" class="text-button">Open ChatGPT for an image <BlogArrow direction="up-right" /></button><p>Prefer a script that saves a PNG, then drop it into the post. ChatGPT image generation is also available.</p></div>
  </aside>
  </div>
  <noscript><p class="notice">Enable JavaScript to use the editor.</p></noscript>
</BlogLayout>
<script>import { initEditor } from '../scripts/blog-editor'; initEditor();</script>
