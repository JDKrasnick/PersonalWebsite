---
import BlogLayout from '../../layouts/BlogLayout.astro';
---
<BlogLayout>
  <div class="blog-wrap">
    <div class="blog-intro"><h1>Blog</h1><button id="toggle-search" class="archive-search-toggle" type="button" aria-label="Search and filter posts" title="Search and filter posts" aria-controls="archive-sidebar" aria-expanded="false"><svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/></svg></button></div>
    <div id="blog-error" class="notice error" hidden></div>
    <span id="post-count" class="sr-only" aria-live="polite"></span>
    <div id="archive-layout" class="archive-layout">
      <div id="post-list" class="post-list" aria-live="polite"><p class="loading-line">Loading articles…</p></div>
      <aside id="archive-sidebar" class="archive-sidebar" aria-labelledby="search-panel-title" hidden>
        <div class="archive-sidebar-heading"><h2 id="search-panel-title">Search posts</h2><button id="close-search" class="archive-search-toggle" type="button" aria-label="Close search panel"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button></div>
        <label class="sr-only" for="search-posts">Search articles</label><div class="search-box"><input id="search-posts" type="search" placeholder="Search articles…" /></div>
        <h3 class="archive-topic-heading">Topic</h3><div id="tag-filters" class="tag-filters" role="group" aria-label="Filter articles by topic"></div>
        <div class="archive-filter-footer"><span id="filter-count" role="status"></span><button id="reset-search" class="text-button" type="button" hidden>Clear filters</button></div>
      </aside>
    </div>
    <noscript><p class="notice">Enable JavaScript to use the local blog.</p></noscript>
  </div>
</BlogLayout>
<script>import { initIndex } from '../../scripts/blog'; initIndex();</script>
