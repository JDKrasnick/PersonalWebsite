---
import BlogLayout from '../../layouts/BlogLayout.astro';
import { readPublishedPosts } from '../../../scripts/blog-content.mjs';
export const prerender = false;
interface Props { draftPreview?: boolean; post?: Awaited<ReturnType<typeof readPublishedPosts>>[number]; contentHtml?: string; }
const { draftPreview = false, post, contentHtml = '' } = Astro.props;
if (!post && !draftPreview && !import.meta.env.DEV) {
  const slug = Astro.url.searchParams.get('slug');
  const published = slug && (await readPublishedPosts()).find(item => item.slug === slug);
  return Astro.redirect(published ? `/blog/${published.slug}/` : '/blog', 301);
}
const structuredData = post ? JSON.stringify({ '@context': 'https://schema.org', '@type': 'BlogPosting', headline: post.title, description: post.excerpt, datePublished: post.publishedAt, author: { '@type': 'Person', name: 'JD Krasnick', url: 'https://www.jdkrasnick.com/' }, url: `https://www.jdkrasnick.com/blog/${post.slug}/` }).replace(/</g, '\\u003c') : '';
---
<BlogLayout title={post?.title ?? 'Article'} description={post?.excerpt || undefined} image={post?.image || undefined} privatePage={draftPreview}>
  {post && <script is:inline type="application/ld+json" set:html={structuredData} />}
  <div class="reader-wrap" data-draft-preview={draftPreview ? 'true' : undefined}>
    <div id="reader-notice" class="notice" hidden></div>
    <article id="article" data-post-id={post?.id} data-post-slug={post?.slug}>{post ? <>
      <header class="article-header"><h1>{post.title}</h1>{post.excerpt && <p class="article-description">{post.excerpt}</p>}<div class="post-meta"><time datetime={post.publishedAt}>{new Date(post.publishedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}</time>{post.example && <span class="example-badge">Example article</span>}</div></header>
      {post.image && <figure class="article-picture"><img src={post.image} alt={post.imageAlt || ''} width="1200" height="675" fetchpriority="high" /></figure>}
      <div class="prose" set:html={contentHtml} />
    </> : <p class="loading-line">Loading article…</p>}</article>
    <noscript><p class="notice">{post ? 'JavaScript enables interactive demos.' : 'Browse published articles from the blog index.'}</p></noscript>
  </div>
</BlogLayout>
<script>import { initReader } from '../../scripts/blog'; initReader();</script>
