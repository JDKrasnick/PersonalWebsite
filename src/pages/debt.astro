---
import '../styles/global.css';
import { debts } from '../data/debts';

const dollars = new Intl.NumberFormat('en-US', {
  style: 'currency',
  currency: 'USD',
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Debt | JD Krasnick</title>
    <meta name="description" content="Individual balances and JD's Venmo." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <main>
      <header>
        <h1>Debt</h1>
        <p>Amounts owed to JD.</p>
      </header>

      <table>
        <caption class="sr-only">Individual debt amounts in US dollars</caption>
        <thead>
          <tr><th scope="col">Name</th><th scope="col">Amount (USD)</th></tr>
        </thead>
        <tbody>
          {debts.map(({ name, amount }) => (
            <tr>
              <th scope="row">{name}</th>
              <td>
                {amount === null
                  ? <span class="sr-only">Amount not entered</span>
                  : dollars.format(amount)}
              </td>
            </tr>
          ))}
        </tbody>
      </table>

      <footer>
        <p>Send payment on Venmo</p>
        <a href="https://venmo.com/jdkras" target="_blank" rel="noopener noreferrer">
          @jdkras
          <span class="sr-only"> (opens in a new tab)</span>
        </a>
      </footer>
    </main>
  </body>
</html>

<style>
  main {
    width: min(100% - 3rem, 38rem);
    margin: 0 auto;
    padding: clamp(2.5rem, 8vw, 5rem) 0 3rem;
  }

  header { margin-bottom: 2.5rem; }
  h1 { font-size: clamp(2.5rem, 7vw, 3.5rem); }
  header p, footer p { color: var(--text-secondary); }
  header p { margin-top: 0.625rem; }

  table { width: 100%; border-collapse: collapse; }
  thead th {
    color: var(--text-secondary);
    font-size: 0.8125rem;
    font-weight: 500;
    padding: 0 0 0.875rem;
  }
  th { text-align: left; }
  tr > :last-child { text-align: right; }
  tbody tr { border-top: 1px solid var(--border-color); }
  tbody th, td { padding: 0.875rem 0; font-size: 1rem; }
  tbody th { font-weight: 500; }
  td { font-variant-numeric: tabular-nums; }

  footer { margin-top: 2rem; }
  footer p { font-size: 0.875rem; margin-bottom: 0.25rem; }
  footer a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  a:focus-visible { outline: 2px solid var(--accent); outline-offset: 5px; }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>
