---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import ScrollRail from '../components/ScrollRail.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Divider from '../components/Divider.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import Skills from '../components/Skills.astro';
import Contact from '../components/Contact.astro';
import BackgroundPreview from '../components/backgrounds/BackgroundPreview';
import type { BackgroundVariant } from '../lib/backgrounds';
import type { AboutEffectVariant } from '../lib/about-effects';
import type { DitherArtVariant } from '../lib/dither-art';

interface Props {
  background?: BackgroundVariant;
  aboutEffect?: AboutEffectVariant;
  ditherImage?: DitherArtVariant;
}
const { background, aboutEffect, ditherImage } = Astro.props;
const activeBackground = background ?? 'ghost-fibers';
const activeAboutEffect = aboutEffect ?? 'laser-flow';
---

<Layout noindex={Boolean(background || aboutEffect)}>
  <Navbar />
  <ScrollRail topLabel="loss 1.00" bottomLabel="min" />
  <main class="background-variation">
    <BackgroundPreview variant={activeBackground} showControls={Boolean(background)} client:only="react" />
    <Hero />
    <div class="portfolio-body">
      <About effect={activeAboutEffect} ditherImage={ditherImage} preview={Boolean(aboutEffect)} />
      <Divider variant="periwinkle" />
      <Experience />
      <Projects />
      <Skills />
      <Divider variant="periwinkle-thin" />
      <Contact />
    </div>
  </main>
</Layout>

<style>
  .background-variation {
    position: relative;
    isolation: isolate;
    background: #080a15;
  }
</style>

<script>
  // Scroll reveal
  const revealElements = document.querySelectorAll('.reveal');
  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          revealObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
  );
  revealElements.forEach((el) => revealObserver.observe(el));

  // GSAP hero entrance
  import('gsap').then(({ gsap }) => {
    gsap.fromTo(
      '.hero-content .reveal',
      { opacity: 0, y: 30 },
      {
        opacity: 1,
        y: 0,
        duration: 0.7,
        stagger: 0.1,
        ease: 'power3.out',
        delay: 0.15,
      }
    );
  });

  // Active nav link + scroll rail marker
  const sections = document.querySelectorAll('section[id]');
  const navLinks = document.querySelectorAll('.nav-links a');
  const railMarker = document.getElementById('rail-marker');

  const handleScroll = () => {
    const scrollY = window.scrollY + 200;
    sections.forEach((section) => {
      const sectionEl = section as HTMLElement;
      const top = sectionEl.getBoundingClientRect().top + window.scrollY;
      const height = sectionEl.offsetHeight;
      const id = sectionEl.getAttribute('id');

      if (scrollY >= top && scrollY < top + height) {
        navLinks.forEach((link) => {
          link.classList.remove('active');
          if (link.getAttribute('href') === `#${id}`) {
            link.classList.add('active');
          }
        });
      }
    });

    if (railMarker) {
      const maxScroll = document.body.scrollHeight - window.innerHeight;
      const progress = maxScroll > 0 ? window.scrollY / maxScroll : 0;
      railMarker.style.top = `${progress * 100}%`;
    }
  };

  window.addEventListener('scroll', handleScroll, { passive: true });
  handleScroll();
</script>
