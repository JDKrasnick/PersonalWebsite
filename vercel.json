{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/debt(?:/.*)?",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow, noarchive, nosnippet, noimageindex"
      },
      "continue": true
    },
    {
      "src": "/debt-media/.*",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow, noarchive, nosnippet, noimageindex"
      },
      "continue": true
    },
    { "handle": "filesystem" },
    {
      "src": "/(.*)",
      "status": 307,
      "headers": { "Location": "/" }
    }
  ]
}
