{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    { "src": "^/blog/llms-suck-at-computer-use/?$", "status": 308, "headers": { "Location": "/blog/beyond-monolithic-llms-rethinking-computer-use/" } },
    { "src": "^/blog/post/?$", "dest": "/_render" },
    { "src": "^/blog/(editor|login|logout|preview)/?$", "dest": "/_render" },
    { "src": "^/api/blog(?:/.*)?$", "dest": "/_render" },
    { "src": "^/api/comments/?$", "dest": "/_render" },
    { "src": "^/api/contributions/?$", "dest": "/_render" },
    { "src": "^/api/github-activity/?$", "dest": "/_render" },
    { "handle": "filesystem" },
    {
      "src": "/(.*)",
      "status": 307,
      "headers": { "Location": "/" }
    }
  ]
}
